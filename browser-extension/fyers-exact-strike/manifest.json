{
  "manifest_version": 3,
  "name": "F&O Radar – FYERS Stock Opener",
  "version": "1.3.0",
  "description": "Opens the signal's underlying NSE equity in FYERS Web.",
  "permissions": [
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://trade.fyers.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["radar-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://trade.fyers.in/*"
      ],
      "js": ["fyers-controller.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "F&O Radar – FYERS Stock Opener"
  }
}
