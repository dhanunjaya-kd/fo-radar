# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-render-app.onrender.com

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/fno_sniper
DB_NAME=fno_sniper
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# Redis (for Channels + Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Fyers API v3
FYERS_APP_ID=your_fyers_app_id
FYERS_APP_SECRET=your_fyers_app_secret
FYERS_REDIRECT_URI=http://localhost:8000/fyers/callback/

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# NewsAPI
NEWSAPI_KEY=your_newsapi_key

# Paper Trading
PAPER_TRADING_ENABLED=True

# Sniper Signals -- quality confirmation gate (views.py, ~line 408).
# When true, a candidate must ALSO clear quality_engine.py's own score
# (70+, TRADE or WATCH tier) on top of the base technical score
# (ENTRY_SCORE_THRESHOLD=50) before it's shown in Sniper Signals or
# sent to Telegram. Defaults to false as of Sep 21 2026 -- the
# stricter true was the actual cause of Sniper Signals showing 0
# during live market hours with 207/208 stocks live; false shows
# every candidate clearing just the base technical score instead, a
# lower confidence bar by the app's own quality metric, not a bug fix.
# Set to true here to opt back into the stricter gate.
ENABLE_QUALITY_CONFIRMATION_GATE=false

# Backtest Integration
BACKTEST_MASTER_PATH=/path/to/SNIPER_TOP5_BACKTEST_MASTER.xlsx
