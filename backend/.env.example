# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-render-app.onrender.com

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/fno_sniper
DB_NAME=fno_sniper
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# Redis (for Channels + Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Fyers API v3
FYERS_APP_ID=your_fyers_app_id
FYERS_APP_SECRET=your_fyers_app_secret
FYERS_REDIRECT_URI=http://localhost:8000/fyers/callback/

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# NewsAPI
NEWSAPI_KEY=your_newsapi_key

# Paper Trading
PAPER_TRADING_ENABLED=True

# Sniper Signals -- quality confirmation gate (views.py, ~line 408).
# When true, a candidate must ALSO clear quality_engine.py's own score
# (70+, TRADE or WATCH tier) on top of the base technical score
# (ENTRY_SCORE_THRESHOLD=50) before it's shown in Sniper Signals or
# sent to Telegram. Defaults to false as of Sep 21 2026 -- the
# stricter true was the actual cause of Sniper Signals showing 0
# during live market hours with 207/208 stocks live; false shows
# every candidate clearing just the base technical score instead, a
# lower confidence bar by the app's own quality metric, not a bug fix.
# Set to true here to opt back into the stricter gate.
ENABLE_QUALITY_CONFIRMATION_GATE=false

# ---------------------------------------------------------------------------
# Sniper v3 (screener/sniper_v3.py) -- every value shown is the default.
# SNIPER_V3_ENABLED=false restores the legacy behaviour (no new gates, plain
# top-8 slice) with no code change.
# ---------------------------------------------------------------------------
SNIPER_V3_ENABLED=true
SNIPER_REQUIRE_DIRECTIONAL_RSI=true     # SELL needs RSI<50, BUY needs RSI>50
SNIPER_BUY_MIN_ADX=35                   # BUY needs ADX>=35 (0 disables); SELL has no extra floor
SNIPER_MAX_COST_TO_RISK=0.30            # bid/ask spread as a fraction of 1R (entry-SL)
SNIPER_TRIGGER_MODE=shadow              # off | shadow (log only) | enforce (block entries w/o an intraday trigger)
SNIPER_SAME_DAY_LOCK=true               # one call per symbol per day
SNIPER_MAX_ACTIVE=8
SNIPER_MAX_ACTIVE_PER_DIRECTION=6
SNIPER_MAX_ACTIVE_PER_SECTOR=2
SNIPER_MAX_NEW_PER_30MIN=3
SNIPER_ENTRY_START=09:15
SNIPER_ENTRY_END=14:00                  # no NEW calls after this; active calls keep being tracked
SNIPER_MAX_HOLD_MIN=150

# Backtest Integration
BACKTEST_MASTER_PATH=/path/to/SNIPER_TOP5_BACKTEST_MASTER.xlsx

# --- AI Decision Summary / research narrative -------------------------------------------------
# Primary provider: gemini (default) | anthropic | groq | openrouter | custom
AI_PROVIDER=gemini
GEMINI_API_KEY=
# A second Gemini model (free-tier quotas are per model) -- used when the main one is out of quota/overloaded
GEMINI_FALLBACK_MODEL=
# Backups, used automatically (in this order) when the primary fails; set any of them:
GROQ_API_KEY=
GROQ_MODEL=                # optional, default openai/gpt-oss-120b (run `python list_llm_models.py` to see what your key can use)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=          # optional, default meta-llama/llama-3.3-70b-instruct:free
ANTHROPIC_API_KEY=
# Any OpenAI-compatible server, e.g. a local Ollama:  http://localhost:11434/v1  +  a model you have pulled
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional: explicit backup order, e.g. AI_FALLBACKS=groq,anthropic
AI_FALLBACKS=
