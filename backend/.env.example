# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-render-app.onrender.com

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/fno_sniper
DB_NAME=fno_sniper
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# Redis (for Channels + Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Fyers API v3
FYERS_APP_ID=your_fyers_app_id
FYERS_APP_SECRET=your_fyers_app_secret
FYERS_REDIRECT_URI=http://localhost:8000/fyers/callback/

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# NewsAPI
NEWSAPI_KEY=your_newsapi_key

# Paper Trading
PAPER_TRADING_ENABLED=True

# Backtest Integration
BACKTEST_MASTER_PATH=/path/to/SNIPER_TOP5_BACKTEST_MASTER.xlsx
